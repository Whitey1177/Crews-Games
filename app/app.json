{
  "expo": {
    "name": "Pup Slope",
    "slug": "pup-slope",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#9ccfff",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#9ccfff"
    },
    "ios": {
      "bundleIdentifier": "com.whitey1177.pupslope",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarHidden": true,
        "NSUserTrackingUsageDescription": "This lets Pup Slope show you ads that are more relevant to you. You can still play either way."
      }
    },
    "android": {
      "package": "com.whitey1177.pupslope",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#9ccfff"
      }
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3731881236858467~2914110279",
          "userTrackingUsageDescription": "This lets Pup Slope show you ads that are more relevant to you. You can still play either way."
        }
      ]
    ]
  }
}